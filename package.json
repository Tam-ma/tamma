{
  "name": "tamma",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered autonomous development orchestration platform",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "vitest",
    "test:unit": "vitest --run --testPathPattern=\\.unit\\.test\\.ts$",
    "test:integration": "vitest --run --testPathPattern=\\.integration\\.test\\.ts$",
    "test:e2e": "vitest run --testPathPattern=\\.e2e\\.test\\.ts$ --testTimeout=300000",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --build packages/shared packages/platforms packages/providers packages/orchestrator packages/cli && pnpm --filter @tamma/dashboard run typecheck && pnpm --filter @tamma/dashboard-user run typecheck",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "migrate:latest": "pnpm --filter @tamma/orchestrator run migrate:latest",
    "migrate:rollback": "pnpm --filter @tamma/orchestrator run migrate:rollback",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "e2e:report": "playwright show-report e2e/playwright-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "ai",
    "automation",
    "orchestration",
    "development",
    "workflow",
    "autonomous"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/meywd/tamma.git"
  },
  "license": "MIT",
  "author": "meywd",
  "pnpm": {
    "overrides": {
      "lodash@<4.18.0": "^4.18.0",
      "lodash-es@<4.18.0": "^4.18.0",
      "undici@^6": "^6.29.1",
      "undici@^7": "^7.30.1",
      "glob@>=10.0.0 <10.5.0": "^10.5.0",
      "minimatch@<3.1.3": "^3.1.3",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "vite@^8": "^8.1.6",
      "vitest@^4": "^4.1.12",
      "@vitest/coverage-v8@^4": "^4.1.12",
      "@vitest/mocker@>=2.1.0-beta.7 <4.1.12": "^4.1.12",
      "rollup@^4": "^4.59.0",
      "ajv@^8": "^8.18.0",
      "mdast-util-to-hast@^13": "^13.2.1",
      "qs@^6": "^6.16.1",
      "ajv@<6.14.0": ">=6.14.0",
      "diff@<8.0.3": ">=8.0.3",
      "esbuild@<0.25.0": ">=0.25.0",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "js-yaml@^3": "^3.14.2",
      "js-yaml@^4": "^4.1.1",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4",
      "path-to-regexp@^8": "^8.4.0",
      "dompurify@^3": "^3.4.17",
      "hono@^4": "^4.13.16",
      "@hono/node-server@<2.1.3": "^2.1.3",
      "@humanfs/node@<0.16.8": ">=0.16.8",
      "@modelcontextprotocol/sdk@<1.32.0": "^1.32.0",
      "@opentelemetry/core@<2.8.0": "^2.8.0",
      "body-parser@^2": "^2.4.0",
      "brace-expansion@>=3.0.0 <5.0.12": "^5.0.12",
      "fast-copy@^4": "^4.1.0",
      "fast-uri@^3": "^3.1.9",
      "fastify@^5": "^5.12.5",
      "find-my-way@<=9.6.0": "^9.7.0",
      "form-data@^3": "^3.0.5",
      "happy-dom@<21.0.4": "^21.0.4",
      "katex@<0.18.2": "^0.18.2",
      "mermaid@^11": "^11.16.1",
      "nanoid@<3.3.12": "^3.3.12",
      "nanoid@^5": "^5.1.16",
      "postcss@^8": "^8.5.23",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "proxy-addr@<2.0.8": "^2.0.8",
      "shell-quote@<1.8.4": ">=1.8.4",
      "react-router@^7": "^7.18.2",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@^1": "^1.2.2",
      "ws@^8": "^8.20.1",
      "uuid@<11.1.1": "^11.1.1",
      "ip-address@<10.7.4": ">=10.7.4",
      "zod@^4": "^4.6.6"
    }
  }
}
